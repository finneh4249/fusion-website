---
import { Icon } from 'astro-icon/components'

interface Props {
  heading: string
  description: string
  buttonText: string
  footerText: string
}

const { heading, description, buttonText, footerText } = Astro.props
---

<section class="bg-surface-base border-t border-white/10 py-20 md:py-28 px-6 md:px-10 lg:px-16">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl">
      <h2
        class="font-display font-black uppercase text-white mb-6"
        style="font-size: clamp(2.5rem, 4vw + 0.75rem, 4.5rem); line-height: 0.92; letter-spacing: -0.025em;"
      >
        {heading}
      </h2>

      <p
        class="font-bold text-white/70 mb-10"
        style="font-size: clamp(1.1rem, 1.5vw + 0.4rem, 1.375rem); line-height: 1.55; max-width: 55ch;"
      >
        {description}
      </p>

      <a
        href="https://www.fusionparty.org.au/join"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-magenta text-white font-black uppercase px-8 py-5 rounded-sm hover:scale-[1.02] transition-all duration-150 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-yellow"
        style="font-size: 1.125rem; letter-spacing: 0.06em;"
      >
        {buttonText}
        <Icon name="mdi:arrow-right" class="w-5 h-5 shrink-0" />
      </a>

      <p class="text-xs font-bold text-white/60 mt-5">
        {footerText}
      </p>

      <!-- Low-friction fallback: capture the email even if they're not ready to join -->
      <div class="mt-12 pt-8 border-t border-white/10 max-w-md">
        <p class="text-sm font-black uppercase tracking-wide text-white/80 mb-3">
          Not ready to join? Get election updates instead.
        </p>
        <form id="member-signup-newsletter-form" class="flex flex-col sm:flex-row gap-2">
          <label class="sr-only" for="member-signup-email">Email address</label>
          <input
            id="member-signup-email"
            type="email"
            required
            placeholder="Enter your email"
            class="flex-1 px-3 py-2.5 text-sm rounded-sm border border-white/15 bg-surface-raised text-white placeholder-white/30 focus:outline-none focus:border-magenta transition-colors"
          />
          <button
            type="submit"
            class="px-4 py-2.5 bg-white/10 text-white rounded-sm text-sm font-black uppercase hover:bg-white/20 transition-colors whitespace-nowrap cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Keep Me Posted
          </button>
        </form>
        <div id="member-signup-newsletter-message" class="hidden text-xs font-medium mt-2"></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Mirrors the footer newsletter form — submits to NationBuilder via /api/newsletter
  const form = document.getElementById('member-signup-newsletter-form') as HTMLFormElement | null
  const message = document.getElementById('member-signup-newsletter-message')

  if (form && message) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const input = form.querySelector('input[type="email"]') as HTMLInputElement | null
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      if (!input) return

      const email = input.value
      if (button) button.disabled = true
      message.classList.add('hidden')

      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        })

        if (res.ok) {
          message.textContent = `Success — ${email} added to alerts.`
          message.classList.remove('text-magenta')
          message.classList.add('text-mint')
          message.classList.remove('hidden')
          form.classList.add('hidden')
        } else {
          message.textContent = "Couldn't subscribe right now — please try again shortly."
          message.classList.remove('text-mint')
          message.classList.add('text-magenta')
          message.classList.remove('hidden')
        }
      } catch {
        message.textContent = "Couldn't subscribe right now — please try again shortly."
        message.classList.remove('text-mint')
        message.classList.add('text-magenta')
        message.classList.remove('hidden')
      } finally {
        if (button) button.disabled = false
      }
    })
  }
</script>
